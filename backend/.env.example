# Prefer direct host (port 5432) for local dev; pooler (6543) is fine at runtime after schema exists.
DATABASE_URL=postgresql://user:password@localhost:5432/z2_coach
# Set to true to skip legacy ALTER-on-startup (faster boots when schema is already up to date).
# DB_SKIP_STARTUP_MIGRATIONS=false
GEMINI_API_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
AUTH_SECRET=generate-a-long-random-string
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/callback
STRAVA_BACKFILL_MONTHS=12
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated backups if primary is overloaded (503)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-preview-05-20
LOG_LEVEL=INFO
ENABLE_TRACING=false

# Optional: python seed_db.py creates only this account (your real email)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=choose-a-strong-password
SEED_USER_MAX_HR=188
SEED_USER_RESTING_HR=56
